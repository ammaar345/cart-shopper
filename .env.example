# Copy this file to .env.local and fill in to activate the Supabase order sync.
# See SUPABASE.md for setup steps.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for SEO (sitemap.xml, robots.txt, Open Graph).
# Set before deploy, e.g. https://cartshopper.co.za
NEXT_PUBLIC_SITE_URL=http://localhost:3000
